# Copy to .env for local development. Keep this file free of real secrets.
APP_ENV=development
DATA_DIR=.local/dev-data
DATABASE_PATH=.local/dev-data/database.db
UPLOADS_DIR=.local/dev-data/uploads
COOKIE_HTTPS_ONLY=false

# Generate a local secret with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=

# Set a unique test-only password before the first startup to create the initial admin.
INITIAL_ADMIN_PASSWORD=
INITIAL_OPERATOR_PASSWORD=
